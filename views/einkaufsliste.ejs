<!doctype html>
<html lang="de">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <%
    const eur = (value) => value.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
    const num = (value, digits = 2) => value.toLocaleString('de-DE', { maximumFractionDigits: digits });
    const money = (value) => value.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  %>

  <main class="container">
    <div class="page-head">
      <h1>Einkaufsliste</h1>
      <form method="get" action="/einkaufsliste" class="set-picker">
        <label for="shoppingConfigurationSet" class="label">Konfiguration</label>
        <select id="shoppingConfigurationSet" name="set" onchange="this.form.submit()">
          <% sets.forEach(set => { %>
            <option value="<%= set.id %>" <%= selectedSet?.id === set.id ? 'selected' : '' %>><%= set.name %> (<%= set.item_count %>)</option>
          <% }) %>
        </select>
        <noscript><button type="submit" class="btn">Öffnen</button></noscript>
      </form>
      <div class="toolbar-actions">
        <a href="/konfigurator?set=<%= selectedSet?.id || '' %>" class="btn btn-outline">Positionen bearbeiten</a>
        <% if (configurationCount > 0) { %>
          <a href="/einkaufsliste/export.csv?set=<%= selectedSet.id %>" class="btn btn-ghost" download>CSV</a>
          <a href="/einkaufsliste/export.pdf?set=<%= selectedSet.id %>" class="btn btn-ghost" download>PDF</a>
          <button type="button" class="btn btn-ghost" onclick="window.print()">Drucken</button>
        <% } %>
      </div>
    </div>

    <% if (configurationCount === 0) { %>
      <section class="panel empty-state">
        <h2>Noch nichts einzukaufen</h2>
        <p>Lege im Konfigurator Kabelpositionen an. Hier erscheinen dann Kabelmeter, Stecker und die Schnittliste.</p>
        <a href="/konfigurator?set=<%= selectedSet?.id || '' %>" class="btn btn-primary">Zum Konfigurator</a>
      </section>
    <% } else { %>
      <dl class="stats">
        <div><dt class="label">Materialwert brutto</dt><dd class="stat-strong"><%= eur(totalPrice) %></dd></div>
        <div><dt class="label">Kabel bestellen</dt><dd><%= num(totalMeters) %> m</dd></div>
        <div><dt class="label">Stecker</dt><dd><%= totalConnectors %> Stück</dd></div>
        <div><dt class="label">Positionen</dt><dd><%= configurationCount %></dd></div>
      </dl>

      <section class="panel">
        <div class="panel-head">
          <h2>Kabel</h2>
          <form method="post" action="/einkaufsliste/reserve" class="reserve-form">
            <input type="hidden" name="set_id" value="<%= selectedSet.id %>">
            <label for="reservePercent" class="label">Reserve für Verschnitt</label>
            <div class="input-unit">
              <input type="number" id="reservePercent" name="reserve_percent" min="0" max="100" step="1" inputmode="numeric" value="<%= num(reservePercent) %>">
              <span>%</span>
            </div>
            <button type="submit" class="btn btn-outline btn-sm">Übernehmen</button>
          </form>
        </div>
        <div class="table-scroll">
          <table class="data-table stack-mobile">
            <thead>
              <tr>
                <th>Produkt</th>
                <th class="num">Bedarf exakt</th>
                <th class="num">Bestellmenge</th>
                <th class="num">Preis/m</th>
                <th class="num">Summe</th>
                <th><span class="sr-only">Händler</span></th>
              </tr>
            </thead>
            <tbody>
              <% cables.forEach(item => { %>
                <tr>
                  <td class="cell-name"><%= item.name %></td>
                  <td data-label="Bedarf exakt" class="num muted"><%= num(item.exactAmount) %> m</td>
                  <td data-label="Bestellen" class="num strong"><%= num(item.amount) %> m</td>
                  <td data-label="Preis" class="num"><%= money(item.unitPrice) %></td>
                  <td data-label="Summe" class="num strong"><%= money(item.totalPrice) %></td>
                  <td class="cell-link">
                    <% if (item.website) { %>
                      <a href="<%= item.website %>" target="_blank" rel="noopener">Zum Händler</a>
                    <% } else { %>
                      <span class="muted">Kein Link</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p class="table-note">
          <% if (reservePercent > 0) { %>
            Bestellmenge = Bedarf + <%= num(reservePercent) %> % Reserve, aufgerundet auf 10 cm.
          <% } else { %>
            Ohne Reserve: Verschnitt und Abisolierlängen sind nicht eingerechnet.
          <% } %>
        </p>
      </section>

      <section class="panel">
        <div class="panel-head">
          <h2>Schnittliste</h2>
          <span class="muted">Zuschnitte je Kabeltyp, längste zuerst</span>
        </div>
        <div class="cut-list">
          <% cables.forEach(item => { %>
            <div class="cut-row">
              <div class="cut-cable">
                <strong><%= item.name %></strong>
                <span class="muted"><%= item.cutCount %> Zuschnitte · <%= num(item.exactAmount) %> m</span>
              </div>
              <ul class="cuts">
                <% item.cuts.forEach(cut => { %>
                  <li><span class="cut-count"><%= cut.count %> ×</span> <%= num(cut.lengthM) %> m</li>
                <% }) %>
              </ul>
            </div>
          <% }) %>
        </div>
      </section>

      <section class="panel">
        <div class="panel-head">
          <h2>Stecker</h2>
        </div>
        <div class="table-scroll">
          <table class="data-table stack-mobile">
            <thead>
              <tr>
                <th>Produkt</th>
                <th class="num">Menge</th>
                <th class="num">Stückpreis</th>
                <th class="num">Summe</th>
                <th><span class="sr-only">Händler</span></th>
              </tr>
            </thead>
            <tbody>
              <% connectors.forEach(item => { %>
                <tr>
                  <td class="cell-name"><%= item.name %></td>
                  <td data-label="Menge" class="num strong"><%= item.amount %></td>
                  <td data-label="Preis" class="num"><%= money(item.unitPrice) %></td>
                  <td data-label="Summe" class="num strong"><%= money(item.totalPrice) %></td>
                  <td class="cell-link">
                    <% if (item.website) { %>
                      <a href="<%= item.website %>" target="_blank" rel="noopener">Zum Händler</a>
                    <% } else { %>
                      <span class="muted">Kein Link</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr>
                <td>Summe</td>
                <td data-label="Stecker" class="num"><%= totalConnectors %></td>
                <td></td>
                <td data-label="Summe" class="num strong"><%= money(connectors.reduce((sum, item) => sum + item.totalPrice, 0)) %></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>
    <% } %>

    <section class="panel offers">
      <div class="panel-head">
        <h2>Angebote vergleichen</h2>
        <span class="muted">Fertigkabel oder Rollenware nach Preis pro Meter</span>
      </div>

      <form method="post" action="/einkaufsliste" class="offer-form">
        <input type="hidden" name="set_id" value="<%= selectedSet?.id || '' %>">
        <label class="field field-grow">
          <span class="label">Bezeichnung</span>
          <input type="text" name="name" placeholder="z.B. Titanex 3G2,5 – 50-m-Ring" required>
        </label>
        <label class="field field-grow">
          <span class="label">Link (optional)</span>
          <input type="url" name="website" placeholder="https://…">
        </label>
        <label class="field">
          <span class="label">Preis €</span>
          <input type="number" step="0.01" min="0" name="price" inputmode="decimal" required>
        </label>
        <label class="field">
          <span class="label">Länge m</span>
          <input type="number" step="0.01" min="0.01" name="length_m" inputmode="decimal" required>
        </label>
        <button type="submit" class="btn btn-primary">Hinzufügen</button>
      </form>

      <% if (offers.length > 0) { %>
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Bezeichnung</th>
                <th class="num">Länge</th>
                <th class="num">Preis</th>
                <th class="num">Preis/m</th>
                <th><span class="sr-only">Link</span></th>
                <th><span class="sr-only">Aktionen</span></th>
              </tr>
            </thead>
            <tbody>
              <% offers.forEach(offer => { %>
                <tr class="<%= offer.id === cheapestOfferId ? 'is-best' : '' %>">
                  <td class="cell-name">
                    <%= offer.name %>
                    <% if (offer.id === cheapestOfferId && offers.length > 1) { %><span class="tag">Günstigster Meterpreis</span><% } %>
                  </td>
                  <td class="num"><%= num(offer.length_m) %> m</td>
                  <td class="num"><%= money(offer.price) %></td>
                  <td class="num strong"><%= money(offer.price_per_meter) %></td>
                  <td class="cell-link">
                    <% if (offer.website) { %><a href="<%= offer.website %>" target="_blank" rel="noopener">Zum Angebot</a><% } %>
                  </td>
                  <td>
                    <div class="row-actions">
                      <form method="post" action="/einkaufsliste/<%= offer.id %>/delete" onsubmit="return confirm('Angebot löschen?');">
                        <input type="hidden" name="set_id" value="<%= selectedSet?.id || '' %>">
                        <button type="submit" class="btn btn-ghost btn-sm btn-danger">Löschen</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
