<!doctype html>
<html lang="de">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <% const money = (value) => value.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>

  <main class="container">
    <div class="page-head">
      <h1>Stecker &amp; Kabel</h1>
      <nav class="tabs" aria-label="Stammdatenbereich">
        <a href="/stammdaten?bereich=kabel" class="<%= selectedArea === 'kabel' ? 'active' : '' %>">Kabel <span class="count"><%= cables.length %></span></a>
        <a href="/stammdaten?bereich=stecker" class="<%= selectedArea === 'stecker' ? 'active' : '' %>">Stecker <span class="count"><%= connectors.length %></span></a>
      </nav>
      <div class="toolbar-actions">
        <% if (selectedArea === 'kabel') { %>
          <a href="/stammdaten?bereich=kabel&amp;neu=1#editor" class="btn btn-primary">Neues Kabel</a>
        <% } else { %>
          <a href="/stammdaten?bereich=stecker&amp;neu=1#editor" class="btn btn-primary">Neuer Stecker</a>
        <% } %>
      </div>
    </div>

    <% if (error) { %>
      <p class="alert" role="alert"><%= error %></p>
    <% } %>

    <% if (selectedArea === 'kabel') { %>
      <% if (showCreateForm || editCable) { %>
        <section class="panel entry entry-editing" id="editor">
          <div class="panel-head">
            <h2><%= editCable ? 'Kabel bearbeiten' : 'Neues Kabel' %></h2>
            <% if (editCable) { %><span class="muted"><%= editCable.name %></span><% } %>
          </div>

          <% if (categories.length === 0) { %>
            <p class="empty">Lege zuerst unten eine Kabelkategorie an, z.B. „Strom“.</p>
          <% } else { %>
            <form method="post" action="<%= editCable ? `/stammdaten/kabel/${editCable.id}/edit` : '/stammdaten/kabel' %>" class="master-form" data-price-form data-vat-rate="<%= vatRate %>">
              <label class="field field-grow">
                <span class="label">Name</span>
                <input type="text" name="name" value="<%= editCable?.name || '' %>" placeholder="z.B. Titanex 3G2,5" required>
              </label>
              <label class="field">
                <span class="label">Kategorie</span>
                <select name="category_id" data-cable-category required>
                  <% categories.forEach(category => { %>
                    <option value="<%= category.id %>" <%= editCable?.category_id === category.id ? 'selected' : '' %>><%= category.name %></option>
                  <% }) %>
                </select>
              </label>
              <label class="field field-price">
                <span class="label">Netto €/m</span>
                <input type="number" step="0.01" min="0" name="net_price_per_meter" inputmode="decimal" value="<%= editCable ? editCable.net_price_per_meter.toFixed(2) : '' %>" data-net-price>
              </label>
              <label class="field field-price">
                <span class="label">Brutto €/m</span>
                <input type="number" step="0.01" min="0" name="gross_price_per_meter" inputmode="decimal" value="<%= editCable ? editCable.price_per_meter.toFixed(2) : '' %>" data-gross-price>
              </label>
              <label class="field field-full">
                <span class="label">Link zum Händler (optional)</span>
                <input type="url" name="website" value="<%= editCable?.website || '' %>" placeholder="https://…">
              </label>

              <div class="custom-fields field-full" data-custom-fields></div>
              <input type="hidden" name="price_basis" value="<%= editCable ? 'gross' : '' %>" data-price-basis>

              <div class="form-footer field-full">
                <span class="muted">Netto und Brutto werden mit <%= vatRate * 100 %> % MwSt. abgeglichen.</span>
                <div class="entry-actions">
                  <a href="/stammdaten?bereich=kabel" class="btn btn-ghost">Abbrechen</a>
                  <button type="submit" class="btn btn-primary"><%= editCable ? 'Änderungen speichern' : 'Kabel anlegen' %></button>
                </div>
              </div>
            </form>
          <% } %>
        </section>
      <% } %>

      <section class="panel">
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Kategorie</th>
                <th>Eigenschaften</th>
                <th class="num">Netto/m</th>
                <th class="num">Brutto/m</th>
                <th><span class="sr-only">Händler</span></th>
                <th><span class="sr-only">Aktionen</span></th>
              </tr>
            </thead>
            <tbody>
              <% cables.forEach(cable => { %>
                <tr class="<%= editCable?.id === cable.id ? 'is-editing' : '' %>">
                  <td class="cell-name"><%= cable.name %></td>
                  <td><%= cable.category_name || '–' %></td>
                  <td>
                    <% if (cable.custom_fields.length > 0) { %>
                      <dl class="props">
                        <% cable.custom_fields.forEach(field => { %>
                          <div><dt><%= field.name %></dt><dd><%= field.value %></dd></div>
                        <% }) %>
                      </dl>
                    <% } else { %><span class="muted">–</span><% } %>
                  </td>
                  <td class="num"><%= money(cable.net_price_per_meter) %></td>
                  <td class="num strong"><%= money(cable.price_per_meter) %></td>
                  <td class="cell-link">
                    <% if (cable.website) { %><a href="<%= cable.website %>" target="_blank" rel="noopener">Zum Händler</a><% } %>
                  </td>
                  <td>
                    <div class="row-actions">
                      <a href="/stammdaten?bereich=kabel&amp;edit=<%= cable.id %>#editor" class="btn btn-ghost btn-sm">Bearbeiten</a>
                      <form method="post" action="/stammdaten/kabel/<%= cable.id %>/delete" onsubmit="return confirm('Kabel löschen? Gespeicherte Positionen behalten ihre Produktdaten.');">
                        <button type="submit" class="btn btn-ghost btn-sm btn-danger">Löschen</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (cables.length === 0) { %>
                <tr><td colspan="7" class="empty">Noch keine Kabel angelegt.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="panel">
        <div class="panel-head">
          <h2>Kabelkategorien</h2>
          <form method="post" action="/stammdaten/kategorie" class="inline-form inline-form-compact">
            <input type="text" name="name" placeholder="Neue Kategorie, z.B. Audio" aria-label="Neue Kabelkategorie" required>
            <button type="submit" class="btn btn-outline">Anlegen</button>
          </form>
        </div>

        <div class="category-grid">
          <% categories.forEach(category => { %>
            <article class="category">
              <div class="category-head">
                <strong><%= category.name %></strong>
                <span class="muted"><%= category.cable_count %> Kabel</span>
                <% if (category.cable_count === 0) { %>
                  <form method="post" action="/stammdaten/kategorie/<%= category.id %>/delete" onsubmit="return confirm('Kategorie und ihre Felder löschen?');">
                    <button type="submit" class="btn-icon" title="Kategorie löschen" aria-label="Kategorie <%= category.name %> löschen">×</button>
                  </form>
                <% } %>
              </div>

              <div class="chips">
                <% category.fields.forEach(field => { %>
                  <span class="chip">
                    <%= field.name %>
                    <form method="post" action="/stammdaten/kategorie/<%= category.id %>/feld/<%= field.id %>/delete" onsubmit="return confirm('Feld und alle eingetragenen Werte löschen?');">
                      <button type="submit" class="btn-icon" title="Feld löschen" aria-label="Feld <%= field.name %> löschen">×</button>
                    </form>
                  </span>
                <% }) %>
                <% if (category.fields.length === 0) { %><span class="muted">Keine Zusatzfelder</span><% } %>
              </div>

              <form method="post" action="/stammdaten/kategorie/<%= category.id %>/feld" class="inline-form inline-form-compact">
                <input type="text" name="name" placeholder="Neues Feld, z.B. Querschnitt" aria-label="Neues Feld für <%= category.name %>" required>
                <button type="submit" class="btn btn-outline btn-sm">Feld hinzufügen</button>
              </form>
            </article>
          <% }) %>
          <% if (categories.length === 0) { %><p class="empty">Noch keine Kabelkategorien angelegt.</p><% } %>
        </div>
      </section>
    <% } else { %>
      <% if (showCreateForm || editConnector) { %>
        <section class="panel entry entry-editing" id="editor">
          <div class="panel-head">
            <h2><%= editConnector ? 'Stecker bearbeiten' : 'Neuer Stecker' %></h2>
            <% if (editConnector) { %><span class="muted"><%= editConnector.name %></span><% } %>
          </div>

          <form method="post" action="<%= editConnector ? `/stammdaten/stecker/${editConnector.id}/edit` : '/stammdaten/stecker' %>" class="master-form" data-price-form data-vat-rate="<%= vatRate %>">
            <label class="field field-grow">
              <span class="label">Name</span>
              <input type="text" name="name" value="<%= editConnector?.name || '' %>" placeholder="z.B. PCE CEE 16A 5p Stecker" required>
            </label>
            <label class="field">
              <span class="label">Kategorie (optional)</span>
              <select name="category_id">
                <option value="">Ohne Kategorie</option>
                <% connectorCategories.forEach(category => { %>
                  <option value="<%= category.id %>" <%= editConnector?.category_id === category.id ? 'selected' : '' %>><%= category.name %></option>
                <% }) %>
              </select>
            </label>
            <label class="field field-price">
              <span class="label">Netto €</span>
              <input type="number" step="0.01" min="0" name="net_price" inputmode="decimal" value="<%= editConnector ? editConnector.net_price.toFixed(2) : '' %>" data-net-price>
            </label>
            <label class="field field-price">
              <span class="label">Brutto €</span>
              <input type="number" step="0.01" min="0" name="gross_price" inputmode="decimal" value="<%= editConnector ? editConnector.price.toFixed(2) : '' %>" data-gross-price>
            </label>
            <label class="field field-full">
              <span class="label">Link zum Händler (optional)</span>
              <input type="url" name="website" value="<%= editConnector?.website || '' %>" placeholder="https://…">
            </label>
            <input type="hidden" name="price_basis" value="<%= editConnector ? 'gross' : '' %>" data-price-basis>

            <div class="form-footer field-full">
              <span class="muted">Netto und Brutto werden mit <%= vatRate * 100 %> % MwSt. abgeglichen.</span>
              <div class="entry-actions">
                <a href="/stammdaten?bereich=stecker" class="btn btn-ghost">Abbrechen</a>
                <button type="submit" class="btn btn-primary"><%= editConnector ? 'Änderungen speichern' : 'Stecker anlegen' %></button>
              </div>
            </div>
          </form>
        </section>
      <% } %>

      <section class="panel">
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Kategorie</th>
                <th class="num">Netto</th>
                <th class="num">Brutto</th>
                <th><span class="sr-only">Händler</span></th>
                <th><span class="sr-only">Aktionen</span></th>
              </tr>
            </thead>
            <tbody>
              <% connectors.forEach(connector => { %>
                <tr class="<%= editConnector?.id === connector.id ? 'is-editing' : '' %>">
                  <td class="cell-name"><%= connector.name %></td>
                  <td><%= connector.category_name || '–' %></td>
                  <td class="num"><%= money(connector.net_price) %></td>
                  <td class="num strong"><%= money(connector.price) %></td>
                  <td class="cell-link">
                    <% if (connector.website) { %><a href="<%= connector.website %>" target="_blank" rel="noopener">Zum Händler</a><% } %>
                  </td>
                  <td>
                    <div class="row-actions">
                      <a href="/stammdaten?bereich=stecker&amp;edit=<%= connector.id %>#editor" class="btn btn-ghost btn-sm">Bearbeiten</a>
                      <form method="post" action="/stammdaten/stecker/<%= connector.id %>/delete" onsubmit="return confirm('Stecker löschen? Gespeicherte Positionen behalten ihre Produktdaten.');">
                        <button type="submit" class="btn btn-ghost btn-sm btn-danger">Löschen</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
              <% if (connectors.length === 0) { %>
                <tr><td colspan="6" class="empty">Noch keine Stecker angelegt.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="panel">
        <div class="panel-head">
          <h2>Steckerkategorien</h2>
          <form method="post" action="/stammdaten/stecker-kategorie" class="inline-form inline-form-compact">
            <input type="text" name="name" placeholder="Neue Kategorie, z.B. CEE" aria-label="Neue Steckerkategorie" required>
            <button type="submit" class="btn btn-outline">Anlegen</button>
          </form>
        </div>

        <div class="chips chips-large">
          <% connectorCategories.forEach(category => { %>
            <span class="chip">
              <%= category.name %> <span class="muted"><%= category.connector_count %></span>
              <% if (category.connector_count === 0) { %>
                <form method="post" action="/stammdaten/stecker-kategorie/<%= category.id %>/delete" onsubmit="return confirm('Steckerkategorie löschen?');">
                  <button type="submit" class="btn-icon" title="Kategorie löschen" aria-label="Kategorie <%= category.name %> löschen">×</button>
                </form>
              <% } %>
            </span>
          <% }) %>
          <% if (connectorCategories.length === 0) { %><p class="empty">Noch keine Steckerkategorien angelegt.</p><% } %>
        </div>
      </section>
    <% } %>
  </main>

  <% if (selectedArea === 'kabel' && (showCreateForm || editCable) && categories.length > 0) { %>
    <script>
      window.CABLEBUILDER_CATEGORIES = <%- JSON.stringify(categories).replace(/</g, '\\u003c') %>;
      window.CABLEBUILDER_EDIT_CABLE = <%- JSON.stringify(editCable).replace(/</g, '\\u003c') %>;
    </script>
    <script src="/js/kabelfelder.js"></script>
  <% } %>
  <% if (showCreateForm || editCable || editConnector) { %>
    <script src="/js/preisfelder.js"></script>
  <% } %>
</body>
</html>
